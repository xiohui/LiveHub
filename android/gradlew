#!/bin/sh

GRADLE_VERSION=8.4
APP_HOME=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Gradle $GRADLE_VERSION wrapper..."
    cd /tmp
    curl -sL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "gradle-${GRADLE_VERSION}-bin.zip"
    unzip -q "gradle-${GRADLE_VERSION}-bin.zip"
    "/tmp/gradle-${GRADLE_VERSION}/bin/gradle" wrapper --gradle-version "$GRADLE_VERSION" --distribution-type bin -p "$APP_HOME"
    rm -rf "/tmp/gradle-${GRADLE_VERSION}" "gradle-${GRADLE_VERSION}-bin.zip"
    cd "$APP_HOME"
fi

if [ -z "$JAVA_HOME" ]; then
    JAVA_EXE=java
else
    JAVA_EXE="$JAVA_HOME/bin/java"
fi

exec "$JAVA_EXE" -jar "$WRAPPER_JAR" "$@"
